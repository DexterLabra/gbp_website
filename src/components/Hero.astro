---
const navLinks = [
  { href: "#", text: "Home" },
  { href: "#featured", text: "Featured Products" },
  { href: "#likha", text: "Likha Collections" },
  { href: "#collections", text: "Collections" },
  { href: "#testimonials", text: "Client Feedback" },
  { href: "#exclusive", text: "Exclusive Items" },
  { href: "#shipping", text: "Shipping" },
  { href: "#inquiry", text: "Inquire" },
  { href: "#contact", text: "Contact" },
];
---

<section class="hero" id="hero">
  <div class="hero-content">
    <div class="hero-brand">
      <img
        src="/images/GBP_OFFICIAL_LOGO.png"
        alt="GBP Home Art & Decors official logo"
        class="hero-logo"
        width="240"
        height="240"
        loading="eager"
        decoding="async"
      />
      <h2>GBP Home Art &amp; Decors</h2>
    </div>
    <p class="bio">
      <span>We curate and provide functional and creative decor pieces that bring warmth, character, and elegance to every home.</span>
    </p>

    <nav id="hero-nav" aria-label="Primary navigation" class="hero-nav">
      <ul>
        {navLinks.map((link, index) => (
          <li>
            <a class="hero-nav-link" href={link.href}>
              <span class="hero-nav-number">{String(index + 1).padStart(2, '0')}</span>
              <span class="hero-nav-label">{link.text}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</section>

<style>
  @property --bio-frame-angle {
    syntax: '<angle>';
    inherits: false;
    initial-value: 0deg;
  }

  .hero {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: clamp(640px, 82vh, 860px);
    padding: clamp(40px, 7vw, 80px) 20px;
    overflow: hidden;
    text-align: center;
    background:
      linear-gradient(180deg, rgba(7, 12, 38, 0.88), rgba(15, 24, 94, 0.56)),
      url('/images/GBP_HERO_BG.png') center / cover no-repeat;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 15% 20%, rgba(255, 221, 136, 0.14), transparent 22%),
      radial-gradient(circle at 80% 80%, rgba(255, 255, 255, 0.1), transparent 20%);
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    width: min(100%, 900px);
    animation: heroReveal 900ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .hero-brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(12px, 2vw, 20px);
    margin-bottom: 20px;
  }

  .hero-logo {
    display: block;
    width: clamp(160px, 22vw, 280px);
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 12px 30px rgba(0, 0, 0, 0.24));
    transition: transform 280ms var(--motion-ease), filter 280ms ease;
  }

  .hero h2 {
    max-width: 100%;
    color: #fff;
    font-family: 'Playfair Display', serif;
    font-size: clamp(2rem, 5.2vw, 4.1rem);
    font-weight: 600;
    line-height: 1.12;
    text-wrap: balance;
  }

  .bio {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    max-width: 760px;
    margin: 0 auto;
    padding: clamp(20px, 3.2vw, 32px);
    border: 2px solid #e8c77d;
    border-radius: 26px;
    color: #fff3d6;
    font-family: 'Playfair Display', 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.05rem, 2.1vw, 1.55rem);
    font-weight: 500;
    line-height: 1.7;
    letter-spacing: 0.015em;
    text-shadow: 0 2px 5px rgba(22, 10, 44, 0.25);
    background: linear-gradient(135deg, rgba(15, 23, 75, 0.82), rgba(12, 19, 51, 0.72));
    box-shadow:
      0 18px 48px rgba(4, 10, 34, 0.34),
      inset 0 1px 0 rgba(255, 244, 211, 0.24),
      0 0 0 5px rgba(232, 199, 125, 0.12),
      0 0 16px rgba(255, 221, 136, 0.28),
      0 0 34px rgba(212, 166, 79, 0.2);
    backdrop-filter: blur(14px);
    transition: transform 350ms var(--motion-ease), border-color 350ms ease, box-shadow 350ms ease;
    animation: bioGoldGlow 5s ease-in-out infinite;
  }

  .bio::before {
    position: absolute;
    z-index: 0;
    inset: 0;
    padding: 1.5px;
    border-radius: inherit;
    background: conic-gradient(
      from var(--bio-frame-angle),
      rgba(190, 139, 55, 0.38),
      rgba(255, 244, 211, 0.98),
      rgba(212, 166, 79, 0.48),
      rgba(255, 221, 136, 0.96),
      rgba(190, 139, 55, 0.38)
    );
    content: "";
    pointer-events: none;
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    mask-composite: exclude;
    filter: drop-shadow(0 0 8px rgba(255, 231, 184, 0.72));
    animation: bioFrameShimmer 5s linear infinite;
    transition: filter 350ms ease;
  }

  .bio::after {
    position: absolute;
    z-index: 0;
    top: -55%;
    bottom: -55%;
    left: -75%;
    width: 35%;
    background: linear-gradient(
      100deg,
      transparent,
      rgba(255, 244, 211, 0.04) 28%,
      rgba(255, 244, 211, 0.22) 50%,
      rgba(255, 221, 136, 0.08) 68%,
      transparent
    );
    content: "";
    pointer-events: none;
    transform: skewX(-18deg);
    animation: bioSurfaceShine 5s ease-in-out 1s infinite;
  }

  .bio span {
    position: relative;
    z-index: 1;
    color: #fff3d6;
  }

  .hero-nav {
    display: flex;
    justify-content: center;
    width: 100%;
    margin-top: 30px;
  }

  .hero-nav ul {
    display: grid;
    width: min(100%, 840px);
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: stretch;
    gap: 12px;
    margin: 0;
    padding: clamp(12px, 2vw, 20px);
    border: 1px solid rgba(232, 199, 125, 0.3);
    border-radius: 22px;
    list-style: none;
    background: rgba(8, 15, 41, 0.7);
    box-shadow: 0 18px 42px rgba(4, 10, 34, 0.25), inset 0 1px rgba(255, 248, 220, 0.06);
  }

  .hero-nav ul li {
    min-width: 0;
  }

  .hero-nav-link {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    width: 100%;
    min-height: 58px;
    gap: 12px;
    padding: 10px 16px;
    border: 1px solid rgba(232, 199, 125, 0.52);
    border-radius: 13px;
    color: #fff5dc;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.025em;
    line-height: 1.25;
    text-align: left;
    text-wrap: balance;
    text-decoration: none;
    background: linear-gradient(145deg, rgba(20, 29, 61, 0.96), rgba(8, 15, 41, 0.96));
    box-shadow: inset 0 1px rgba(255, 248, 220, 0.1), 0 5px 16px rgba(4, 10, 34, 0.2);
    transition: transform 320ms var(--motion-ease), color 260ms ease, border-color 320ms ease, box-shadow 320ms ease, background 320ms ease;
  }

  .hero-nav-link::before {
    position: absolute;
    z-index: 0;
    top: -60%;
    bottom: -60%;
    left: -85%;
    width: 48%;
    content: "";
    background: linear-gradient(
      100deg,
      transparent,
      rgba(255, 248, 220, 0.12) 28%,
      rgba(255, 248, 220, 0.78) 50%,
      rgba(232, 199, 125, 0.26) 68%,
      transparent
    );
    transform: skewX(-20deg);
    transition: left 700ms cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
  }

  .hero-nav-link::after {
    position: absolute;
    z-index: 1;
    right: 14px;
    bottom: 0;
    left: 14px;
    height: 1px;
    border-radius: 999px;
    background: linear-gradient(90deg, transparent, #f3d79a, transparent);
    content: "";
    opacity: 0;
    transform: scaleX(0.3);
    transform-origin: left center;
    transition: opacity 260ms ease, transform 320ms var(--motion-ease);
    pointer-events: none;
  }

  .hero-nav-number,
  .hero-nav-label {
    position: relative;
    z-index: 1;
  }

  .hero-nav-number {
    flex: 0 0 2ch;
    color: #e8c77d;
    font-family: 'Playfair Display', serif;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .hero-nav-label {
    min-width: 0;
  }

  .hero-nav-link.active {
    border-color: #f3d79a;
    color: #ffe8ad;
    background: linear-gradient(145deg, #332b22, #161d32 74%);
    box-shadow: inset 0 1px rgba(255, 248, 220, 0.16), 0 0 18px rgba(232, 199, 125, 0.2);
  }

  .hero-nav-link.active::after {
    opacity: 0.9;
    transform: scaleX(1);
  }

  .hero-nav-link:focus-visible {
    outline: 2px solid #ffe6aa;
    outline-offset: 3px;
  }

  @keyframes heroReveal {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes bioFrameShimmer {
    to { --bio-frame-angle: 360deg; }
  }

  @keyframes bioSurfaceShine {
    0%, 45% { left: -75%; }
    75%, 100% { left: 145%; }
  }

  @keyframes bioGoldGlow {
    0%, 100% {
      box-shadow: 0 18px 48px rgba(4, 10, 34, 0.34), inset 0 1px 0 rgba(255, 244, 211, 0.24), 0 0 0 5px rgba(232, 199, 125, 0.12), 0 0 16px rgba(255, 221, 136, 0.25), 0 0 30px rgba(212, 166, 79, 0.18);
    }
    50% {
      box-shadow: 0 20px 52px rgba(4, 10, 34, 0.38), inset 0 1px 0 rgba(255, 244, 211, 0.3), 0 0 0 5px rgba(232, 199, 125, 0.2), 0 0 22px rgba(255, 221, 136, 0.44), 0 0 42px rgba(212, 166, 79, 0.3);
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .hero-logo:hover {
      transform: translateY(-3px) scale(1.025);
      filter: drop-shadow(0 16px 34px rgba(0, 0, 0, 0.3));
    }

    .bio:hover {
      transform: translateY(-4px);
      border-color: #fff0c4;
      box-shadow:
        0 26px 62px rgba(4, 10, 34, 0.4),
        0 0 30px rgba(232, 199, 125, 0.26),
        inset 0 1px 0 rgba(255, 248, 220, 0.28);
      animation-duration: 2.8s;
    }

    .bio:hover::before {
      filter: drop-shadow(0 0 8px rgba(255, 231, 184, 0.72));
      animation-duration: 4s;
    }

    .bio:hover::after {
      animation: bioSurfaceShine 1.2s cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    .hero-nav-link:hover {
      transform: translateY(-3px);
      border-color: #fff0c4;
      color: #fff4d8;
      background: linear-gradient(145deg, #3a3023, #151e35 76%);
      box-shadow:
        inset 0 1px rgba(255, 248, 220, 0.2),
        0 10px 24px rgba(4, 10, 34, 0.28),
        0 0 20px rgba(232, 199, 125, 0.22);
    }

    .hero-nav-link:hover::before {
      left: 145%;
    }

    .hero-nav-link:hover::after {
      opacity: 0.85;
      transform: scaleX(1);
    }
  }

  @media (max-width: 768px) {
    .hero {
      min-height: max(620px, calc(100vh - 62px));
      min-height: max(620px, calc(100svh - 62px));
      padding: 38px 18px;
    }

    .hero h2 {
      font-size: clamp(1.85rem, 6vw, 2.8rem);
    }

    .hero-logo {
      width: clamp(160px, 32vw, 220px);
    }

    .bio {
      font-size: clamp(0.95rem, 2.4vw, 1.1rem);
      border-radius: 22px;
    }

    .hero-nav {
      margin-top: 22px;
    }

    .hero-nav ul {
      width: min(100%, 600px);
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }
  }

  @media (max-width: 500px) {
    .hero {
      min-height: max(620px, calc(100vh - 58px));
      min-height: max(620px, calc(100svh - 58px));
      padding: 32px 16px;
    }

    .hero-brand {
      margin-bottom: 16px;
    }

    .hero h2 {
      font-size: clamp(1.8rem, 8vw, 2.3rem);
    }

    .hero-logo {
      width: clamp(148px, 42vw, 184px);
    }

    .bio {
      padding: 18px;
      font-size: 0.95rem;
    }

    .hero-nav-link {
      min-height: 52px;
      gap: 8px;
      padding: 8px 10px;
      font-size: 0.75rem;
    }

    .hero-nav ul {
      padding: 10px;
      gap: 8px;
    }

    .hero-nav-number {
      font-size: 0.72rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-content,
    .hero-nav-link,
    .hero-nav-link::before,
    .hero-nav-link::after,
    .bio,
    .bio::before,
    .bio::after {
      animation: none;
      transition: none;
    }
  }
</style>

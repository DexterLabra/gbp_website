---
const navLinks = [
  { href: "#", text: "Home" },
  { href: "#featured", text: "Featured Products" },
  { href: "#likha", text: "Likha Collections" },
  { href: "#collections", text: "Collections" },
  { href: "#testimonials", text: "Client Feedback" },
  { href: "#shipping", text: "Shipping" },
  { href: "#inquiry", text: "Inquire" },
  { href: "#contact", text: "Contact" },
];
---

<section class="hero" id="hero">
  <div class="hero-content">
    <div class="hero-brand">
      <img
        src="/images/GBP_OFFICIAL_LOGO.png"
        alt="GBP Home Art & Decors official logo"
        class="hero-logo"
        width="240"
        height="240"
        loading="eager"
        decoding="async"
      />
      <h2>GBP Home Art &amp; Decors</h2>
    </div>
    <p class="bio">
      We curate and provide functional and creative decor pieces that bring warmth, character, and elegance to every home.
    </p>

    <nav id="hero-nav" aria-label="Primary navigation" class="hero-nav">
      <ul>
        {navLinks.map((link) => (
          <li>
            <a class="hero-nav-link" href={link.href}>{link.text}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: clamp(640px, 82vh, 860px);
    padding: clamp(40px, 7vw, 80px) 20px;
    overflow: hidden;
    text-align: center;
    background:
      linear-gradient(180deg, rgba(7, 12, 38, 0.88), rgba(15, 24, 94, 0.56)),
      url('/images/GBP_HERO_BG.png') center / cover no-repeat;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 15% 20%, rgba(255, 221, 136, 0.14), transparent 22%),
      radial-gradient(circle at 80% 80%, rgba(255, 255, 255, 0.1), transparent 20%);
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    width: min(100%, 900px);
    animation: heroReveal 900ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .hero-brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(12px, 2vw, 20px);
    margin-bottom: 20px;
  }

  .hero-logo {
    display: block;
    width: clamp(160px, 22vw, 280px);
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 12px 30px rgba(0, 0, 0, 0.24));
    transition: transform 280ms var(--motion-ease), filter 280ms ease;
  }

  .hero h2 {
    max-width: 100%;
    color: #fff;
    font-family: 'Playfair Display', serif;
    font-size: clamp(2rem, 5.2vw, 4.1rem);
    font-weight: 600;
    line-height: 1.12;
    text-wrap: balance;
  }

  .bio {
    max-width: 760px;
    margin: 0 auto;
    padding: clamp(20px, 3.2vw, 32px);
    border: 1px solid rgba(241, 197, 122, 0.36);
    border-radius: 26px;
    color: #fff3d6;
    font-family: 'Playfair Display', 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.05rem, 2.1vw, 1.55rem);
    font-weight: 500;
    line-height: 1.7;
    letter-spacing: 0.015em;
    text-shadow: 0 2px 5px rgba(22, 10, 44, 0.25);
    background: linear-gradient(135deg, rgba(15, 23, 75, 0.62), rgba(255, 255, 255, 0.09));
    box-shadow: 0 18px 48px rgba(4, 10, 34, 0.24), inset 0 1px 0 rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(14px);
    transition: transform 280ms var(--motion-ease), border-color 280ms ease, box-shadow 280ms ease;
  }

  .hero-nav {
    display: flex;
    justify-content: center;
    width: 100%;
    margin-top: 30px;
  }

  .hero-nav ul {
    display: grid;
    width: min(100%, 900px);
    grid-template-columns: repeat(4, minmax(0, 1fr));
    align-items: stretch;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero-nav ul li {
    min-width: 0;
  }

  .hero-nav-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 52px;
    padding: 8px 12px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 999px;
    color: #fff;
    font-size: 0.85rem;
    font-weight: 600;
    line-height: 1.25;
    text-align: center;
    text-wrap: balance;
    text-decoration: none;
    background: rgba(255, 255, 255, 0.08);
    transition: transform 260ms var(--motion-ease), background-color 260ms ease, border-color 260ms ease, box-shadow 260ms ease;
  }

  .hero-nav-link.active {
    border-color: #d4a64f;
    color: #ffd978;
    background: rgba(212, 166, 79, 0.18);
  }

  .hero-nav-link:focus-visible {
    outline: 2px solid #ffe6aa;
    outline-offset: 3px;
  }

  @keyframes heroReveal {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (hover: hover) and (pointer: fine) {
    .hero-logo:hover {
      transform: translateY(-3px) scale(1.025);
      filter: drop-shadow(0 16px 34px rgba(0, 0, 0, 0.3));
    }

    .bio:hover {
      transform: translateY(-3px);
      border-color: rgba(255, 226, 164, 0.58);
      box-shadow: 0 24px 58px rgba(4, 10, 34, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.26);
    }

    .hero-nav-link:hover {
      transform: translateY(-2px);
      border-color: rgba(255, 226, 164, 0.6);
      background: rgba(255, 255, 255, 0.16);
      box-shadow: 0 8px 20px rgba(4, 10, 34, 0.18);
    }
  }

  @media (max-width: 768px) {
    .hero {
      min-height: max(620px, calc(100vh - 62px));
      min-height: max(620px, calc(100svh - 62px));
      padding: 38px 18px;
    }

    .hero h2 {
      font-size: clamp(1.85rem, 6vw, 2.8rem);
    }

    .hero-logo {
      width: clamp(160px, 32vw, 220px);
    }

    .bio {
      font-size: clamp(0.95rem, 2.4vw, 1.1rem);
      border-radius: 22px;
    }

    .hero-nav {
      margin-top: 22px;
    }

    .hero-nav ul {
      width: min(100%, 520px);
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
    }
  }

  @media (max-width: 500px) {
    .hero {
      min-height: max(620px, calc(100vh - 58px));
      min-height: max(620px, calc(100svh - 58px));
      padding: 32px 16px;
    }

    .hero-brand {
      margin-bottom: 16px;
    }

    .hero h2 {
      font-size: clamp(1.8rem, 8vw, 2.3rem);
    }

    .hero-logo {
      width: clamp(148px, 42vw, 184px);
    }

    .bio {
      padding: 18px;
      font-size: 0.95rem;
    }

    .hero-nav-link {
      padding: 8px 6px;
      font-size: 0.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-content {
      animation: none;
    }
  }
</style>
